# ──────────────────────────────────────────
# BASE DE DATOS
# ──────────────────────────────────────────
POSTGRES_DB=ocr_documentos
POSTGRES_USER=ocr_user
POSTGRES_PASSWORD=cambia_esta_contrasena

# ──────────────────────────────────────────
# BACKEND
# ──────────────────────────────────────────
DATABASE_URL=postgresql://ocr_user:cambia_esta_contrasena@localhost:5432/ocr_documentos
# Genera una propia: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Sin SECRET_KEY el backend usa una temporal y las sesiones se cierran en cada reinicio.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Administrador inicial: se crea al arrancar si este correo no existe.
# Nunca cambia usuarios existentes. Usa una contraseña propia y larga.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia_esta_contrasena

# ──────────────────────────────────────────
# CORREO (recuperación de contraseña)
# Con Gmail: activa la verificación en dos pasos de la cuenta y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords.
# Sin SMTP_HOST, "¿Olvidaste tu contraseña?" responde que no está configurada.
# ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=contrasena_de_aplicacion_de_16_letras
# Dirección pública del frontend, para el enlace del correo (en producción es obligatoria)
FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────
# DIRECTORIOS
# ──────────────────────────────────────────
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_FILE_SIZE_MB=50
# Tope de un envío de subida completo (varios PDF + planilla)
MAX_SUBIDA_TOTAL_MB=500

# ──────────────────────────────────────────
# ENTORNO
# ──────────────────────────────────────────
ENVIRONMENT=development

# ──────────────────────────────────────────
# PGADMIN
# ──────────────────────────────────────────
PGADMIN_EMAIL=tu_correo@example.com
PGADMIN_PASSWORD=cambia_esta_contrasena

# ──────────────────────────────────────────
# FRONTEND
# ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ──────────────────────────────────────────
# GOOGLE CLOUD DOCUMENT AI
# Motor OCR principal (Tesseract es el fallback automático)
# ──────────────────────────────────────────

# ID del proyecto en Google Cloud (ya configurado: ocr-sena)
GOOGLE_CLOUD_PROJECT=ocr-sena

# Región del procesador Document AI
GOOGLE_DOCUMENT_AI_LOCATION=us

# ID de tu procesador Document AI — REEMPLAZA con tu ID real
# Ejemplo: abc123def456789a
# Lo encuentras en: Google Cloud Console > Document AI > Mis procesadores
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=REEMPLAZA_CON_TU_PROCESSOR_ID

# Habilitar/deshabilitar Google Document AI
# false = usa Tesseract directamente (útil para pruebas sin credenciales)
GOOGLE_DOCUMENT_AI_ENABLED=true

# Ruta al JSON de credenciales del Service Account
# En ejecución LOCAL:  ./credentials/google-document-ai.json
# En Docker (ya configurado en docker-compose.yml): /app/credentials/google-document-ai.json
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-document-ai.json
